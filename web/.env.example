# Public — embedded in the Vite client bundle
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server only — never prefix with VITE_
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
AUTH_SERVER_PORT=3001

# Server only — keep this URI out of VITE_ variables and client code
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/

# Optional server-only contact address used in Web Push VAPID details
PUSH_CONTACT_EMAIL=support@example.com
